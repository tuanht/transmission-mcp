# Copy to .env for docker compose. For running Python directly, export these in your shell.
# Bundled daemon (--profile transmission):  http://transmission:9091/transmission/rpc
# Transmission on the host (docker, Linux): http://host.docker.internal:9091/transmission/rpc
#   (needs `extra_hosts: ["host.docker.internal:host-gateway"]` on the transmission-mcp service)
# Python directly:                          http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_URL=http://transmission:9091/transmission/rpc
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
MCP_PORT=8650
